# Docker-stack host ports for the Vite client. To run the client against the docker-compose stack, copy this to .env.local (or .env) and restart vite.
VITE_AUTH_URL=http://localhost:5001
VITE_GAME_URL=http://localhost:5002
VITE_LEADERBOARD_URL=http://localhost:5003
# the website, for the "register on the website" link on the sign-in board
VITE_WEBSITE_URL=http://localhost:5004
