# Where the published game finds its services: through the website it's played
# on (web/next.config.ts passes /svc/a, /svc/g and /svc/l on to them), so it's
# one address and one sign-in. Used by `npm run build`, which web/ runs itself
# (web/scripts/build-game.mjs) — it wins over .env.local.
VITE_AUTH_URL=/svc/a
VITE_GAME_URL=/svc/g
VITE_LEADERBOARD_URL=/svc/l
