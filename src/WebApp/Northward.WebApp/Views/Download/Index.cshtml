@{
    ViewData["Title"] = "download";
}

<section class="hero">
    <h1>download northward.</h1>
    <p>the game runs on macos and windows. coming soon to linux.</p>

    <div style="margin-top:3rem;display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:1.25rem;max-width:800px;">
        <a href="#" class="hero__cta" style="justify-content:space-between;width:100%;">
            <span>macos · apple silicon</span>
            <span>→</span>
        </a>
        <a href="#" class="hero__cta" style="justify-content:space-between;width:100%;">
            <span>macos · intel</span>
            <span>→</span>
        </a>
        <a href="#" class="hero__cta" style="justify-content:space-between;width:100%;">
            <span>windows · 64-bit</span>
            <span>→</span>
        </a>
    </div>

    <p style="margin-top:3rem;color:var(--muted);font-size:0.9rem;">
        about 40 mb. requires you to create an account first.
    </p>
</section>
