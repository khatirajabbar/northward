@{
    ViewData["Title"] = "how to play";
}

<section class="hero">
    <h1>how to play.</h1>
    <p>northward is a side-scrolling adventure. simple controls, gentle pace.</p>

    <div style="margin-top:3rem;max-width:600px;">
        <h3 style="margin-top:2rem;">movement</h3>
        <p>arrow keys or wasd to walk left and right.</p>

        <h3 style="margin-top:2rem;">interact</h3>
        <p>press e to talk to animals, pick up items, or examine things in the forest.</p>

        <h3 style="margin-top:2rem;">jump</h3>
        <p>space bar. you can also crouch with s or down arrow to fit through small spaces.</p>

        <h3 style="margin-top:2rem;">kindness</h3>
        <p>be gentle with the animals you meet. they remember, and the forest rewards patience.</p>
    </div>
</section>
