# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<your-postgres-password>
POSTGRES_AUTH_DB=northward_auth
POSTGRES_GAME_DB=northward_game
POSTGRES_LEADERBOARD_DB=northward_leaderboard

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=<your-rabbitmq-password>

# JWT
JWT_SECRET=<your-jwt-secret-min-32-chars>
JWT_ISSUER=northward-auth
JWT_AUDIENCE=northward-client
