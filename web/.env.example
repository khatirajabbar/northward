# Where the site finds the game's services and the game itself.
# Copy this file to .env.local for your own machine.

# the game's services (only the site's server talks to them)
AUTH_URL=http://localhost:5001
LEADERBOARD_URL=http://localhost:5003
# the game service (the site only asks it to delete an account's journeys)
GAME_URL=http://localhost:5002

# where the play page loads the game from
#   on your machine: the game's dev server (npm run dev in game-client)
#   published: the built game, served by this same site
NEXT_PUBLIC_GAME_URL=http://localhost:5173
